# Whitelist: ignore everything in the thesis folder, then let through only the code.
# No data and no results go in (Cboe licence), no thesis, no notes or logs.
/*
!/.gitignore
!/README.md
!/LICENSE
!/requirements.txt
!/Code/
!/checks/
!/Data/

# Data/: only the README that describes the layout
/Data/*
!/Data/README.md

# checks/: no review tools, no data
/checks/review_2026-10/
/checks/data/

# everywhere: no outputs, no Python caches
*.csv
*.txt
!/requirements.txt
__pycache__/
*.pyc
